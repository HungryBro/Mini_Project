# VerneMQ that already receives payload/mqtt/gateway.py summaries.
MQTT_BROKER=172.16.2.117
MQTT_PORT=1883
MQTT_TOPIC=v1/6610301004
MQTT_QOS=1
MQTT_CONNECT_CLIENT_ID=kafka_connect_traffic_CAM_112

# Kafka topic used inside this Docker Compose stack.
KAFKA_TOPIC=traffic.krung_thon_bridge.summary.v1
KAFKA_CONSUMER_GROUP=telegraf_traffic_influx_v1
CONNECT_URL=http://localhost:8083

# Cloud InfluxDB destination. The token is used only by the local Telegraf
# container when it writes the final metrics to this bucket.
INFLUX_URL=http://172.16.2.117:8086
INFLUX_ORG=my-org
INFLUX_BUCKET=mini_project
INFLUX_TOKEN=replace_with_your_mini_project_write_token
