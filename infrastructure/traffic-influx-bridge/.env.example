# Cloud MQTT Broker that already receives the V2 traffic summary.
MQTT_BROKER=172.16.2.117
MQTT_PORT=1883
MQTT_QOS=1
MQTT_TOPIC=traffic/krung_thon_bridge/CAM_112/summary
TELEGRAF_CLIENT_ID=telegraf_traffic_CAM_112

# InfluxDB OSS v2 destination shown in Data Explorer.
INFLUX_URL=http://172.16.2.117:8086
INFLUX_ORG=my-org
INFLUX_BUCKET=iot_data
INFLUX_TOKEN=replace_with_a_write_token_for_iot_data
